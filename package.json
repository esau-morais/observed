{
  "name": "observed-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:skills",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "bun run --filter '*' build",
    "check:skills": "bun scripts/check-skills.ts",
    "measure:request-lab": "bun scripts/measure-request-lab.ts",
    "gates": "bun scripts/gate-corpus/run.ts",
    "gates:check": "bun scripts/gate-corpus/check.ts",
    "gates:missing": "bun scripts/gate-corpus/missing.ts",
    "gates:faults": "bun scripts/gate-corpus/faults.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@observed/judge": "workspace:*",
    "@tanstack/intent": "0.5.5",
    "@types/bun": "1.4.3",
    "effect": "4.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes"
    ]
  }
}

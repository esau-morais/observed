{
  "name": "observed-gate-playwright",
  "private": true,
  "type": "commonjs",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test:e2e": "bun run --bun playwright test --reporter=line,json",
    "install-browser": "bun run --bun playwright install chromium",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "typescript": "6.0.3"
  }
}
